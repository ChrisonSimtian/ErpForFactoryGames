<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace></RootNamespace>

    <!-- Fallout conventions: build project sits in build/, scripts at the repo root. -->
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>

    <!-- Suppress noisy diagnostics common in Fallout build scripts. -->
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE0079;NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Fallout is the hard-fork successor to NUKE; published to nuget.org (ADR-0021).

      Pinned exactly with bracket notation. A bare version in NuGet is a
      *minimum*, not a match, so this file said "10.3.5" while every build was
      quietly resolving 11.0.8 — a major version nobody chose. The pin records
      what we actually run.

      11.0.8 specifically, and not something newer or older:
        • 10.4.0 hangs the Test target. It waits on the test process, which does
          not exit promptly here, then kills it — the build fails with exit 143
          after every test has passed. Reproducible locally and on CI.
        • 11.0.18 moved Fallout.Common.ProjectModel, so Build.cs no longer
          compiles against it. Worth doing deliberately, not as a version bump.
        • 11.0.8 is what CI has in fact been green on for months.
    -->
    <PackageReference Include="Fallout.Common" Version="[11.0.8]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deploy library: Cloudflare reconcile + plan primitives consumed by the Provision target. -->
    <ProjectReference Include="..\tools\Erp.Deploy\Erp.Deploy.csproj" />
  </ItemGroup>

</Project>
